{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check": "npm run lint && npm run check:names && npm test && npm run build",
    "check:names": "node scripts/check-file-names.mjs",
    "lint": "eslint .",
    "test": "node --import tsx --test \"test/**/*.test.js\"",
    "test:coverage": "c8 --all --include='src/**/*.js' --include='src/**/*.jsx' --reporter=text --reporter=html node --import tsx --test \"test/**/*.test.js\"",
    "preview": "vite preview"
  },
  "dependencies": {
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "socket.io-client": "^4.8.1",
    "three": "^0.183.2",
    "three-bvh-csg": "^0.0.18",
    "three-mesh-bvh": "^0.9.9"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.27",
    "c8": "^12.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "postcss": "^8.5.6",
    "react-test-renderer": "^19.3.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.15",
    "vite": "^7.3.1"
  }
}
